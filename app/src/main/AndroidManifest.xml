<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />

    <!-- ARCore 必須アプリ。非対応端末には Play ストアで配信しない。 -->
    <uses-feature
        android:name="android.hardware.camera.ar"
        android:required="true" />
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ARCoreFetcher"
        tools:targetApi="34">

        <!-- Google Play Services for AR を必須としてインストールさせる。 -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="required" />

        <!--
            起動はタイトル画面から。カメラ権限と ARCore のインストール要求は
            MainActivity 側に置いてあるので、撮影を選ぶまで何も尋ねられない。
        -->
        <activity
            android:name=".TitleActivity"
            android:exported="true"
            android:theme="@style/Theme.ARCoreFetcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:screenOrientation="locked"
            android:theme="@style/Theme.ARCoreFetcher" />

        <!-- 書き出した ZIP を共有シートに渡すための FileProvider。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
