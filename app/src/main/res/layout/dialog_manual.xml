<?xml version="1.0" encoding="utf-8"?>
<!--
    使い方ダイアログの中身。タイトル画面とカメラ画面の両方から開く。
    内容は固定なので ID は振らない（ManualDialog がそのまま inflate する）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            style="@style/ManualHeading"
            android:layout_marginTop="0dp"
            android:text="@string/manual_h_what" />

        <TextView
            style="@style/ManualBody"
            android:text="@string/manual_what" />

        <TextView
            style="@style/ManualHeading"
            android:text="@string/manual_h_steps" />

        <TextView
            style="@style/ManualBody"
            android:text="@string/manual_steps" />

        <TextView
            style="@style/ManualHeading"
            android:text="@string/manual_h_wait" />

        <TextView
            style="@style/ManualBody"
            android:text="@string/manual_wait" />

        <TextView
            style="@style/ManualHeading"
            android:text="@string/manual_h_tips" />

        <TextView
            style="@style/ManualBody"
            android:text="@string/manual_tips" />

        <TextView
            style="@style/ManualHeading"
            android:text="@string/manual_h_notes" />

        <TextView
            style="@style/ManualBody"
            android:text="@string/manual_notes" />
    </LinearLayout>
</ScrollView>
